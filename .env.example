WB_CLIENT_SECRET=your_wb_secret
WB_AUTHORIZATION_TEMPLATE={token}
ADMIN_AUTHORIZATION_TOKEN=admin-local-token
WB_TIMEOUT_SECONDS=30
WB_RETRIES=0

AUTH_BASE_URL=http://token-validator-mock:9000
AUTH_ISSUE_PATH=/auth/issue
AUTH_VERIFY_PATH=/auth/verify
AUTH_TIMEOUT_SECONDS=10

DATABASE_URL_ASYNC=postgresql+asyncpg://wb:wb@postgres:5432/wb_wrapper
DATABASE_URL_SYNC=postgresql://wb:wb@postgres:5432/wb_wrapper

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

CORS_ORIGINS=http://localhost:3000
