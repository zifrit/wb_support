APP_NAME="WB Wrapper"
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TESTING=false
DEBUG_USERNAME=debug
ADMIN_USERNAME=admin


CORS_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000


WB_TIMEOUT_SECONDS=30
WB_RETRIES=0
WB_CLIENT_SECRET=your_wb_secret
WB_USER_AGENT=


DEBUG_AUTHORIZATION_TOKEN=debug-local-token


AUTH_BASE_URL=http://token-validator-mock:9000
AUTH_SEND_CODE=/api/authentication/support/send-otp
AUTH_VERIFY_CODE=/api/authentication/support/check-otp
AUTH_VERIFY_TOKEN=/api/authentication/support/verify-token
AUTH_TIMEOUT_SECONDS=10


TEST_DATABASE_URL_ASYNC=sqlite+aiosqlite:///./app.db
TEST_DATABASE_URL_SYNC=sqlite:///./app.db


DB_HOST=postgres
DB_PORT=5432
DB_USER=wb
DB_PASS=password
DB_NAME=wb_wrapper


ADV_DB_USER=
ADV_DB_PASS=
ADV_DB_HOST=
ADV_DB_PORT=
ADV_DB_NAME=


